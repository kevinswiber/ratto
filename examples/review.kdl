// A review console you can ship: every path derives at load, so the
// SAME file works in a primary checkout, a linked worktree, or a fresh
// clone — nothing is hand-edited per machine. Run it from any git
// repository with something uncommitted in it:
//
//   rat dashboard examples/review.kdl
//
// Focus the `changed` pane, press `s` to put a cursor in it, walk the
// cursor with j/k, and press `x`. The path under the cursor lands in a
// handoff file: a small file the `x` binding writes and the panes below
// trigger on. Then press `a` to record a verdict on it — the board asks
// before it writes. The choice lives in that file, in the filesystem — the
// panes only read it, which is also why it can still be driven by hand
// from another terminal:
//
//   echo src/main.rs > "$(git rev-parse --git-common-dir)/review.sel"
//
// 1. `s` is rat's own key HERE because one pane asked for a cursor
//    (`selectable #true` on `changed`); on a board where none does the
//    key stays free for that board to bind. It marks a line in the
//    focused pane, and every key action then sees that line as
//    $RAT_CURSOR with its styling stripped, its pane as
//    $RAT_CURSOR_PANE, and its 1-based row as $RAT_CURSOR_LINE.
// 2. With no cursor up, none of the three is SET — not set to empty.
//    Gating on $RAT_CURSOR_PANE, as `x` does below, is what tells
//    "nothing is marked" from "the marked line is blank".
// 3. `when` sees the same variables the command does, so `x` declines
//    before it runs anything when the cursor is somewhere else.
// 4. With a clean tree the `changed` pane holds nothing but a blank
//    line. `s` still marks it — a blank line is a real line, which is
//    why the guard below asks which PANE the cursor is in rather
//    than whether the marked text is empty — and `x` writes it, leaving
//    the console in its empty state. Edit a file and the board fills.
// 5. The guard runs before the questions, so a binding that cannot do
//    its job asks nothing: press `a` with nothing selected and one
//    line says so.
// 6. Cancel at any of `a`'s three interruptions — the confirm, the
//    verdict, the summary — and nothing happens. No line is written,
//    and the next press starts over.

title "review"

variables {
    // Once at load, memoized. A linked worktree's `.git` is a FILE, so
    // the store lives under the common dir, and a hardcoded ".git/…"
    // path is correct only in a primary worktree. This line is what
    // makes the board shippable instead of hand-edited per machine.
    store "git rev-parse --git-common-dir" shell=#true

    // The handoff file: where a selection lands, and what the panes
    // below trigger on. A constant that references a command variable
    // is itself once-at-load — it cannot be known before `store` runs.
    sel "{{store}}/review.sel"

    // Deferred: re-derived at every consuming spawn, so a pane always
    // reads the CURRENT selection, not the one from load time. The
    // `test -s` guard is not decoration: empty output FAILS the spawn,
    // and a handoff file is empty in two ways — it does not exist yet,
    // or a write was interrupted and left it zero bytes. `cat`
    // SUCCEEDS on that second one, so `cat … || echo -` alone would
    // still derive empty. The quotes matter too: the path comes from
    // git and may contain spaces. And this string must interpolate, so
    // it cannot be raw — the inner quotes are escaped instead, because
    // a literal can be raw or interpolating, never both.
    cur "test -s \"{{sel}}\" && cat \"{{sel}}\" || echo -" shell=#true defer=#true

    // Where a verdict lands. Beside the handoff file rather than in the
    // working tree — same store, same reasoning, and nothing to clean
    // up out of a checkout.
    log "{{store}}/review.notes"
}

defaults {
    height 6
    border "rounded"
}

// The two small panes share a row so the diff keeps its height: the
// whole board has to fit an 80x24 terminal, and a frame taller than
// the window puts the diff below the fold where a reader has to scroll
// to see the thing they just chose.
row {
    // The cursor's home: one path per line, which is what makes a line
    // index mean a file. Nothing here is derived — this pane is what
    // the reader points at.
    pane "changed" {
        title "changed files"
        height 8
        interval "10s"
        shell #true
        command "git diff --name-only HEAD"
        // The only pane here whose body is a list worth marking, so the
        // only one that asks for a cursor. `s` reaches it from rest,
        // and the panes below never take one.
        selectable #true
    }

    pane "selection" {
        title "current selection"
        // Event-driven: `interval "never"` plus a trigger on the
        // handoff file, so this pane runs only when the selection
        // changes. A trigger on a path that does not exist yet is fine
        // — the watch simply fires when the file appears.
        interval "never"
        trigger "file:{{sel}}"
        shell #true
        command "echo {{cur}}"
    }

    // Joined to this row rather than stacked below it: a row takes its
    // tallest pane's height, so a third pane costs width and leaves the
    // board's 80x24 fit alone. Without it the write's effect would be
    // invisible, and the example would teach nothing the status row did
    // not already say.
    pane "notes" {
        title "verdicts"
        interval "never"
        trigger "file:{{log}}"
        shell #true
        command "test -s \"{{log}}\" && tail -n 5 \"{{log}}\" || echo 'no verdicts yet'"
    }
}

pane "diff" {
    title "what changed"
    height 14
    interval "never"
    trigger "file:{{sel}}"
    // `-` is the empty-selection sentinel `cur` derives when the
    // handoff file is absent or empty.
    shell #true
    command "test \"{{cur}}\" = - && echo select a file to review || git diff HEAD -- \"{{cur}}\""
}

// The write half of the console: the line under the cursor becomes the
// selection, and the panes above find out through their own triggers —
// the dashboard itself keeps nothing. `hide` is the right disposition
// for a write whose effect is already visible in the frame.
//
// The guard is on the PANE, not the text: it declines when the cursor
// sits in the diff pane, where a line is a diff line and not a path,
// and it covers the no-cursor case for free — an unset variable
// expands to empty, and empty is not `changed`. Testing the text with
// `-n` instead would call a blank line "nothing marked".
//
// `printf` rather than `echo`: the line is arbitrary text, and `echo`
// interprets backslashes on some shells and adds a newline on all of
// them.
key "x" {
    description "review the file under the cursor"
    when "test \"$RAT_CURSOR_PANE\" = changed"
    shell #true
    output "hide"
    command "printf '%s' \"$RAT_CURSOR\" > \"{{sel}}\""
}

// The binding this console is for: it asks before it writes. `when`
// runs first, so pressing it with nothing selected declines in one line
// and asks nothing at all — which is the whole reason the guard is a
// `when` and not the first line of the command.
//
// The verdict is about the file that was SELECTED — what is in the
// handoff file, which is what the diff pane is showing — not about
// wherever the cursor happens to be sitting when the key is pressed.
//
// `>>` rather than `>`: the log is a history a reader can look at, and
// it shows that the board keeps nothing itself.
key "a" {
    description "record a verdict on the selected file"
    when "test -s \"{{sel}}\""
    confirm "Record a verdict?"
    prompt "verdict" choose="looks-good,needs-changes,question"
    prompt "summary" input="One line, please"
    shell #true
    output "hide"
    command "printf '%s\\t%s\\t%s\\n' \"{{cur}}\" \"$RAT_PROMPT_VERDICT\" \"$RAT_PROMPT_SUMMARY\" >> \"{{log}}\""
}

key "X" {
    description "clear the selection"
    // The guard half, and the reason for the capital: `x` chooses, `X`
    // undoes. A `when` on the handoff file itself, so pressing it with
    // nothing selected declines instead of running.
    when "test -s \"{{sel}}\""
    shell #true
    output "hide"
    command ": > \"{{sel}}\""
}

// Variables: declare a name once, reference it anywhere a string is
// written with {{name}}. Run from a git repository:
//
//   rat dashboard examples/variables.kdl
//
// Six facts an author cannot guess:
//
// 1. The sigil is {{name}} by measurement, not taste: `command` and
//    `script` values ARE shell text, so `$name` would need escaping in
//    every board that exists. `$` stays the shell's.
// 2. A plain variable is a constant — and a parameter: `-v limit=8`
//    overrides it for one run. A constant is its own default.
// 3. `shell=#true` derives the value by running the command ONCE at
//    load, memoized for the session. A failure, empty output, or a
//    hang refuses the board by name — a plausible-looking wrong value
//    that a board then watches forever is worse than not starting. If
//    a fallback is meant, write it where the shell already has the
//    operator: `git describe 2>/dev/null || echo -`.
// 4. `defer=#true` re-derives at EVERY consuming spawn — fresh, and
//    paid for with a subprocess per spawn, so the command must be safe
//    to run at any moment, any number of times. A deferred value may
//    appear only where a value is consumed at spawn (command argv,
//    script bodies), never in values parsed at load (trigger,
//    interval, geometry, titles).
// 5. Normal strings interpolate; raw `#"…"#` strings never do — the
//    same deal double and single quotes make in a shell. One literal
//    cannot be both raw and interpolating.
// 6. Variables never read the environment and never consult the
//    `defaults` block — the `shell` under `defaults` below applies to
//    panes and not to any variable. A board's meaning is the board
//    plus its `-v` flags, nothing ambient.

title "variables"

variables {
    // A constant, and the -v parameter: `-v limit=8` wins for one run.
    limit "3"
    // Declared ABOVE the variable it references, deliberately: order
    // carries no meaning here, and a cycle would be refused by name.
    // A constant that references a command variable is itself
    // once-at-load — it cannot be known before `root` has run.
    readme "{{root}}/README.md"
    // Once at load, memoized: the repo root, wherever the board runs.
    root "git rev-parse --show-toplevel" shell=#true
    // Deferred: re-derived at every spawn of every pane that
    // references it, so the pane always answers for the current
    // moment rather than the moment the board loaded.
    head "git rev-parse --short HEAD" shell=#true defer=#true
}

defaults {
    height 6
    border "rounded"
    // Panes inherit this; the variables above do not (fact 6).
    shell #true
}

pane "log" {
    // Constants expand wherever they are consumed — the title at
    // load, the argv element at spawn — and an expansion lands INSIDE
    // the element that held it, never re-split.
    title "last {{limit}} commits"
    command "git log --oneline -{{limit}}"
}

pane "head" {
    // A raw string is literal end to end: the braces below reach the
    // border verbatim, which is how you write the reference SHAPE
    // without the reference.
    title #"{{head}} means: re-derived per spawn"#
    command "echo now at {{head}}"
    interval "10s"
}

pane "readme" {
    // A derived path is legal at a load-time site because `readme` is
    // load-tier: the trigger registers once, on the expanded path.
    title "README (touch it to refresh)"
    trigger "file:{{readme}}"
    interval "never"
    command "head -4 \"{{readme}}\""
}
